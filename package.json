{
  "name": "maol-stack",
  "version": "0.4.3",
  "description": "A clean-room CLI for stacked Git branches and safe restacks",
  "type": "module",
  "bin": {
    "maol-stack": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "npm run build && vitest run --config vitest.parity.config.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "prepack": "npm run build"
  },
  "keywords": [
    "git",
    "stacked-prs",
    "restack",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "yargs": "^17.7.2",
    "zod": "^4.1.0"
  },
  "overrides": {
    "prompts": {
      "kleur": "$kleur"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^3.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
